# Copy to .env to change these. Everything works without a .env file.

# Where the API finds the database
DATABASE_URL=postgres://seatrush:seatrush@localhost:5432/seatrush

# Port the API listens on
PORT=3000

# How long a hold lasts, in seconds
HOLD_TTL_SECONDS=300

# Most seats one fan can hold or buy in one event
MAX_SEATS_PER_USER=4
